# URL of the JalDrishti API, without a trailing slash.
# Leave empty in development: Vite proxies /api to http://127.0.0.1:8000.
# On Vercel set it to your Render service, e.g. https://jaldrishti-api.onrender.com
VITE_API_BASE=
# Optional backup API used while the main one is down, e.g. the Hugging Face
# Space from docs/BACKUP_BACKEND.md: https://your-name-jaldrishti-api.hf.space
VITE_API_BASE_FALLBACK=

# Wi-Fi alert point (wifi-alert/wifi_alert.py) on the laptop that broadcasts.
# The Notifications page's "Broadcast alert" button calls it. Default below.
# VITE_WIFI_ALERT_URL=http://localhost:8091
